{
  "name": "fazenda-3d",
  "version": "1.0.0",
  "description": "Jogo de fazenda 3D low poly para PC",
  "main": "main.js",
  "private": true,
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder",
    "farming:on": "node scripts/enable-farming.js",
    "farming:off": "node scripts/disable-farming.js",
    "story:on": "node scripts/enable-story.js",
    "story:off": "node scripts/disable-story.js"
  },
  "devDependencies": {
    "electron": "^32.3.3",
    "electron-builder": "^25.1.8"
  },
  "build": {
    "appId": "com.fazenda3d.app",
    "productName": "Fazenda 3D",
    "files": [
      "main.js",
      "preload.js",
      "netIpc.js",
      "src/**/*"
    ],
    "win": {
      "target": [
        {
          "target": "portable",
          "arch": ["x64"]
        },
        {
          "target": "nsis",
          "arch": ["x64"]
        }
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true
    },
    "portable": {
      "artifactName": "Fazenda3D-Portable-${version}.${ext}"
    }
  },
  "dependencies": {
    "three": "^0.185.1",
    "ws": "^8.21.3"
  }
}
